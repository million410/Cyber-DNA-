PROJECT_NAME="Cyber-DNA Platform API"
API_V1_STR="/api/v1"
# Use a managed PostgreSQL database in production. Replace the placeholders.
DATABASE_URI="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME"

# Server-side AI configuration. Never prefix these values with VITE_ or place them in frontend files.
AI_PROVIDER="openai"
AI_MODEL="gpt-6-luna"
OPENAI_API_KEY=""
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=900
AI_MAX_HISTORY=8
AI_MAX_RECORDS=25

# HTTPS cookies on Vercel.
CYBERDNA_COOKIE_SECURE=true
# Keep private; used only for the separate first platform-admin bootstrap flow.
CYBERDNA_BOOTSTRAP_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Optional shared public demo login. Anyone who can read README can use these credentials.
CYBERDNA_DEMO_LOGIN_ENABLED=true
CYBERDNA_DEMO_USERNAME="cyberdna.demo"
CYBERDNA_DEMO_PASSWORD="DemoOnly-CyberDNA-2026!"
CYBERDNA_DEMO_ORGANIZATION_NAME="Cyber DNA Public Demo"
CYBERDNA_DEMO_AI_REQUESTS_PER_HOUR=5

ML_ENABLED=true
ML_MODEL_PATH="models/cyberdna_v25_isolation_forest.joblib"
ML_CONFIG_PATH="models/cyberdna_v25_config.json"
